datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  HEAD_COACH
  COACH
  CLIENT
}

enum ClientStatus {
  LEAD
  ACTIVE
  FROZEN
  INACTIVE
  EXPIRED
  SUSPENDED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

enum CoachRoleInClient {
  PRIMARY
  ASSISTANT
  NUTRITIONIST
  PHYSIOTHERAPIST
}

enum MetricType {
  SETS_REPS_WEIGHT
  DISTANCE_TIME_PACE
  LAPS_TIME
  ROUNDS_REPS_TIME
  TIME_HOLD
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  PERFORMANCE
  REHABILITATION
  GENERAL_FITNESS
}

enum GoalStatus {
  IN_PROGRESS
  ACHIEVED
  ABANDONED
}

enum RestrictionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BodyPart {
  KNEE
  SHOULDER
  LOWER_BACK
  NECK
  ANKLE
  WRIST
  ELBOW
  HIP
  HEART
  ASTHMA
  OTHER
}

enum AssignmentStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  MISSED
}

enum AssignmentSourceType {
  INDIVIDUAL
  TEMPLATE
  PROGRAM
}

enum BlockType {
  SINGLE
  SUPERSET
  CIRCUIT
  SEQUENCE
}

enum BlockItemType {
  EXERCISE
  REST
  NOTE
}

enum NutritionAssignmentMode {
  INHERITED
  CUSTOM_OVERRIDE
  MANUAL
}

enum SessionType {
  INDIVIDUAL
  GROUP
  ASSESSMENT
  RECOVERY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MembershipPlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  ANNUAL
  PERSONAL_TRAINING
  GROUP_CLASS
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum NoteType {
  PRIVATE_COACH
  PUBLIC_CLIENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(CLIENT)
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coachProfile        CoachProfile?
  clientProfile       ClientProfile?
  authoredNotes       ClientNote[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  verifiedMeasurements ClientMeasurementHistory[] @relation("MeasurementVerifications")
  reviewedSubmissions  AthleteCheckInSubmission[] @relation("SubmissionReviews")
  reviewedRequests     CheckInRequest[]           @relation("RequestReviews")
  uploadedPhotoAssets  ClientProgressPhotoAsset[]

  @@map("users")
}

model CoachProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties        String[]
  bio                String?
  yearsOfExperience  Int            @default(0)
  headCoachId        String?
  headCoach          CoachProfile?  @relation("HeadCoachSubordinates", fields: [headCoachId], references: [id])
  subordinateCoaches CoachProfile[] @relation("HeadCoachSubordinates")

  clientAssignments            ClientCoachAssignment[]
  createdTemplates             WorkoutTemplate[]
  createdPrograms              TrainingProgram[]
  createdNutritionPrograms     NutritionProgram[]
  workoutLogs                  WorkoutLog[]
  measurementsTaken            ClientMeasurementHistory[]
  assessmentsGiven             ClientAssessment[]
  mealPlansGiven               MealPlan[]
  nutritionAssignmentsGiven    ClientNutritionAssignment[]
  programAssignmentsGiven      ProgramAssignment[]
  checkInSchedulesConfigured   AthleteCheckInSchedule[]
  sessionsScheduled            SessionCalendar[]
  assignedWorkouts             ClientWorkoutAssignment[]
  publicProfile                PublicCoachProfile?
  checkInRequests              CheckInRequest[]            @relation("RequestedByCoach")

  @@map("coach_profiles")
}

model ClientProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob              DateTime?
  gender           Gender       @default(MALE)
  heightCm         Float?
  weightKg         Float?
  address          String?
  emergencyContact String?
  status           ClientStatus @default(ACTIVE)
  preferredSportId String?
  sport            Sport?       @relation(fields: [preferredSportId], references: [id])
  membershipExpiry DateTime?

  coachAssignments     ClientCoachAssignment[]
  measurements         ClientMeasurementHistory[]
  goals                ClientGoal[]
  medicalRestrictions  ClientMedicalRestriction[]
  progressPhotos       ClientProgressPhoto[]
  assessments          ClientAssessment[]
  workoutAssignments   ClientWorkoutAssignment[]
  programAssignments   ProgramAssignment[]
  nutritionAssignments ClientNutritionAssignment[]
  checkInSchedule      AthleteCheckInSchedule?
  checkInSubmissions   AthleteCheckInSubmission[]
  checkInRequests      CheckInRequest[]
  workoutLogs          WorkoutLog[]
  attendances          SessionAttendance[]
  mealPlans            MealPlan[]
  dailyNutritionLogs   DailyNutritionLog[]
  memberships          Membership[]
  notes                ClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_profiles")
}

model ClientCoachAssignment {
  id         String            @id @default(uuid())
  clientId   String
  client     ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId    String
  coach      CoachProfile      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  role       CoachRoleInClient @default(PRIMARY)
  assignedAt DateTime          @default(now())
  active     Boolean           @default(true)
  notes      String?

  @@unique([clientId, coachId])
  @@map("client_coach_assignments")
}

model Sport {
  id            String   @id @default(uuid())
  nameAr        String
  nameEn        String
  icon          String?
  imageUrl      String?
  descriptionAr String?
  descriptionEn String?
  categories    String[]
  isActive      Boolean  @default(true)

  exercises      Exercise[]
  exerciseSports ExerciseSport[]
  templates      WorkoutTemplate[]
  programs       TrainingProgram[]
  clients        ClientProfile[]
  sessions       SessionCalendar[]

  @@map("sports")
}

model MuscleGroup {
  id        String     @id @default(uuid())
  nameAr    String
  nameEn    String
  code      String     @unique
  exercises Exercise[]

  @@map("muscle_groups")
}

model Equipment {
  id        String     @id @default(uuid())
  nameAr    String
  nameEn    String
  exercises Exercise[]

  @@map("equipment")
}

model Exercise {
  id               String     @id @default(uuid())
  nameAr           String
  nameEn           String
  descriptionAr    String?
  descriptionEn    String?
  instructionsAr   String?
  instructionsEn   String?
  commonMistakesAr String?
  commonMistakesEn String?
  coachTipsAr      String?
  coachTipsEn      String?
  videoUrl         String?
  thumbnailUrl     String?
  difficulty       Difficulty @default(BEGINNER)
  metricType       MetricType @default(SETS_REPS_WEIGHT)
  isActive         Boolean    @default(true)

  sportId         String?
  sport           Sport?       @relation(fields: [sportId], references: [id])
  primaryMuscleId String?
  primaryMuscle   MuscleGroup? @relation(fields: [primaryMuscleId], references: [id])
  equipmentId     String?
  equipment       Equipment?   @relation(fields: [equipmentId], references: [id])

  contraindicatedBodyParts BodyPart[]

  exerciseSports           ExerciseSport[]
  templateExercises        WorkoutTemplateExercise[]
  assignmentExercises      ClientWorkoutAssignmentExercise[]
  loggedExercises          WorkoutExerciseLog[]
  blockItems               BlockItem[]
  assignmentBlockItems     AssignmentBlockItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exercises")
}

model ExerciseSport {
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sportId    String
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([exerciseId, sportId])
  @@index([sportId])
  @@map("exercise_sports")
}

model WorkoutTemplate {
  id            String        @id @default(uuid())
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  sportId       String
  sport         Sport         @relation(fields: [sportId], references: [id])
  difficulty    Difficulty    @default(BEGINNER)
  creatorId     String?
  creator       CoachProfile? @relation(fields: [creatorId], references: [id])
  isActive      Boolean       @default(true)
  version       Int           @default(1)

  exercises       WorkoutTemplateExercise[]
  programWorkouts ProgramWorkout[]
  assignments     ClientWorkoutAssignment[]
  blocks          WorkoutBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id                String          @id @default(uuid())
  templateId        String
  template          WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise        @relation(fields: [exerciseId], references: [id])
  orderIndex        Int             @default(0)
  targetSets        Int?            @default(3)
  targetReps        String?         @default("10-12")
  targetWeightKg    Float?
  targetDistanceKm  Float?
  targetTimeSeconds Int?
  targetPace        String?
  targetRounds      Int?
  restSeconds       Int?            @default(60)
  tempo             String?
  notes             String?

  @@map("workout_template_exercises")
}

model NutritionProgram {
  id            String        @id @default(uuid())
  title         String
  description   String?
  goalType      GoalType?
  dailyCalories Int?
  proteinGrams  Int?
  carbsGrams    Int?
  fatsGrams     Int?
  waterLiters   Float?
  breakfast     String?
  lunch         String?
  dinner        String?
  snacks        String?
  notes         String?
  mealsJson     Json?
  isActive      Boolean       @default(true)
  creatorId     String?
  creator       CoachProfile? @relation(fields: [creatorId], references: [id])

  trainingPrograms  TrainingProgram[]
  clientAssignments ClientNutritionAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nutrition_programs")
}

model TrainingProgram {
  id                 String            @id @default(uuid())
  titleAr            String
  titleEn            String
  descriptionAr      String?
  descriptionEn      String?
  durationWeeks      Int               @default(4)
  sportId            String
  sport              Sport             @relation(fields: [sportId], references: [id])
  goalType           GoalType          @default(GENERAL_FITNESS)
  difficulty         Difficulty        @default(BEGINNER)
  creatorId          String?
  creator            CoachProfile?     @relation(fields: [creatorId], references: [id])
  nutritionProgramId String?
  nutritionProgram   NutritionProgram? @relation(fields: [nutritionProgramId], references: [id], onDelete: SetNull)
  isTemplate         Boolean           @default(true)
  isActive           Boolean           @default(true)
  masterVersion      Int               @default(1)

  weeks              ProgramWeek[]
  assignments        ClientWorkoutAssignment[]
  programAssignments ProgramAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("training_programs")
}

model ProgramWeek {
  id         String          @id @default(uuid())
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  focusAr    String?
  focusEn    String?

  days ProgramDay[]

  @@map("program_weeks")
}

model ProgramDay {
  id        String      @id @default(uuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber Int
  titleAr   String
  titleEn   String
  isRestDay Boolean     @default(false)

  workouts ProgramWorkout[]

  @@map("program_days")
}

model ProgramWorkout {
  id         String           @id @default(uuid())
  dayId      String
  day        ProgramDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  templateId String?
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id])
  title      String?
  orderIndex Int              @default(0)

  blocks WorkoutBlock[]

  @@map("program_workouts")
}

model ProgramAssignment {
  id                   String          @id @default(uuid())
  clientId             String
  client               ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  programId            String
  program              TrainingProgram @relation(fields: [programId], references: [id])
  coachId              String
  coach                CoachProfile    @relation(fields: [coachId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  isActive             Boolean         @default(true)
  notes                String?
  sourceMasterVersion  Int?
  programTitleSnapshot String?

  workoutAssignments   ClientWorkoutAssignment[]
  nutritionAssignments ClientNutritionAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isActive])
  @@map("program_assignments")
}

model ClientWorkoutAssignment {
  id                  String               @id @default(uuid())
  clientId            String
  client              ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId             String
  coach               CoachProfile         @relation(fields: [coachId], references: [id])
  sourceType          AssignmentSourceType @default(TEMPLATE)
  title               String?
  description         String?
  templateId          String?
  template            WorkoutTemplate?     @relation(fields: [templateId], references: [id])
  programId           String?
  program             TrainingProgram?     @relation(fields: [programId], references: [id])
  programAssignmentId String?
  programAssignment   ProgramAssignment?   @relation(fields: [programAssignmentId], references: [id], onDelete: SetNull)
  programWeekNumber   Int?
  programDayNumber    Int?
  programDayTitle     String?
  programWorkoutOrder Int?
  scheduledDate       DateTime
  status              AssignmentStatus     @default(SCHEDULED)
  completedAt         DateTime?
  coachNotes          String?

  exercises        ClientWorkoutAssignmentExercise[]
  assignmentBlocks AssignmentBlock[]
  workoutLog       WorkoutLog?

  createdAt DateTime @default(now())

  @@index([clientId, scheduledDate])
  @@index([programAssignmentId])
  @@map("client_workout_assignments")
}

model ClientWorkoutAssignmentExercise {
  id                String                  @id @default(uuid())
  assignmentId      String
  assignment        ClientWorkoutAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise                @relation(fields: [exerciseId], references: [id])
  exerciseNameEn    String?
  metricType        MetricType              @default(SETS_REPS_WEIGHT)
  orderIndex        Int                     @default(0)
  targetSets        Int?
  targetReps        String?
  targetWeightKg    Float?
  targetDistanceKm  Float?
  targetTimeSeconds Int?
  targetPace        String?
  targetRounds      Int?
  restSeconds       Int?
  tempo             String?
  notes             String?

  @@index([assignmentId, orderIndex])
  @@map("client_workout_assignment_exercises")
}

model WorkoutBlock {
  id                       String           @id @default(uuid())
  templateId               String?
  template                 WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  programWorkoutId         String?
  programWorkout           ProgramWorkout?  @relation(fields: [programWorkoutId], references: [id], onDelete: Cascade)
  orderIndex               Int              @default(0)
  type                     BlockType        @default(SINGLE)
  title                    String?
  rounds                   Int?
  durationSeconds          Int?
  restBetweenRoundsSeconds Int?
  notes                    String?

  items                    BlockItem[]

  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([templateId, orderIndex])
  @@index([programWorkoutId, orderIndex])
  @@map("workout_blocks")
}

model BlockItem {
  id                String        @id @default(uuid())
  blockId           String
  block             WorkoutBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  orderIndex        Int           @default(0)
  itemType          BlockItemType @default(EXERCISE)
  exerciseId        String?
  exercise          Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  targetSets        Int?
  targetReps        String?
  targetWeightKg    Float?
  targetDistanceKm  Float?
  targetTimeSeconds Int?
  targetPace        String?
  targetRounds      Int?
  restSeconds       Int?
  tempo             String?
  instructions      String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([blockId, orderIndex])
  @@map("block_items")
}

model AssignmentBlock {
  id                       String                  @id @default(uuid())
  assignmentId             String
  assignment               ClientWorkoutAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  orderIndex               Int                     @default(0)
  type                     BlockType               @default(SINGLE)
  title                    String?
  rounds                   Int?
  durationSeconds          Int?
  restBetweenRoundsSeconds Int?
  notes                    String?

  items                    AssignmentBlockItem[]

  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([assignmentId, orderIndex])
  @@map("assignment_blocks")
}

model AssignmentBlockItem {
  id                   String            @id @default(uuid())
  assignmentBlockId    String
  assignmentBlock      AssignmentBlock   @relation(fields: [assignmentBlockId], references: [id], onDelete: Cascade)
  orderIndex           Int               @default(0)
  itemType             BlockItemType     @default(EXERCISE)
  exerciseId           String?
  exercise             Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseNameSnapshot String?
  metricTypeSnapshot   MetricType        @default(SETS_REPS_WEIGHT)
  targetSets           Int?
  targetReps           String?
  targetWeightKg       Float?
  targetDistanceKm     Float?
  targetTimeSeconds    Int?
  targetPace           String?
  targetRounds         Int?
  restSeconds          Int?
  tempo                String?
  instructions         String?

  setLogs              SetLog[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([assignmentBlockId, orderIndex])
  @@map("assignment_block_items")
}

model WorkoutLog {
  id              String                   @id @default(uuid())
  assignmentId    String?                  @unique
  assignment      ClientWorkoutAssignment? @relation(fields: [assignmentId], references: [id])
  clientId        String
  client          ClientProfile            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId         String?
  coach           CoachProfile?            @relation(fields: [coachId], references: [id])
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?
  durationMinutes Int?
  overallRpe      Int?
  clientFeedback  String?
  coachFeedback   String?
  isCompleted     Boolean                  @default(false)

  exercises WorkoutExerciseLog[]
  setLogs   SetLog[]

  @@map("workout_logs")
}

model WorkoutExerciseLog {
  id           String     @id @default(uuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  notes        String?

  sets SetLog[]

  @@map("workout_exercise_logs")
}

model SetLog {
  id                    String               @id @default(uuid())
  exerciseLogId         String?
  exerciseLog           WorkoutExerciseLog?  @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  workoutLogId          String?
  workoutLog            WorkoutLog?          @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  assignmentBlockItemId String?
  assignmentBlockItem   AssignmentBlockItem? @relation(fields: [assignmentBlockItemId], references: [id], onDelete: Restrict)
  roundNumber           Int                  @default(1)
  setNumber             Int                  @default(1)
  isCompleted           Boolean              @default(true)
  isSkipped             Boolean              @default(false)
  skipReason            String?
  startedAt             DateTime?
  finishedAt            DateTime?
  coachReview           String?
  coachReviewedAt       DateTime?

  targetReps        String?
  targetWeightKg    Float?
  targetDistanceKm  Float?
  targetTimeSeconds Int?
  targetPace        String?
  targetRounds      Int?
  actualReps        Int?
  actualWeightKg    Float?
  actualDistanceKm  Float?
  actualTimeSeconds Int?
  actualPace        String?
  actualRounds      Int?
  actualRpe         Int?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([workoutLogId, assignmentBlockItemId, roundNumber, setNumber], map: "workout_item_round_set_unique")
  @@index([exerciseLogId])
  @@index([workoutLogId])
  @@index([assignmentBlockItemId])
  @@map("set_logs")
}

enum MeasurementSource {
  COACH_RECORDED
  SELF_REPORTED
  LEGACY
}

enum MeasurementVerificationStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  LEGACY
}

enum PhotoRecordType {
  PHYSIQUE_SET
  INBODY_SCAN
  OTHER
}

enum PhotoAssetAngle {
  FRONT
  SIDE
  BACK
  FULL
  NOT_APPLICABLE
}

enum CheckInReviewStatus {
  PENDING
  REVIEWED
  FLAGGED
}

enum CheckInRequestStatus {
  PENDING
  SUBMITTED
  REVIEWED
  CANCELLED
}

model ClientMeasurementHistory {
  id                       String                        @id @default(uuid())
  clientId                 String
  client                   ClientProfile                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedByCoachId        String?
  recordedByCoach          CoachProfile?                 @relation(fields: [recordedByCoachId], references: [id])
  date                     DateTime                      @default(now())
  weightKg                 Float
  heightCm                 Float?
  bmi                      Float?
  bodyFatPercentage        Float?
  muscleMassKg             Float?
  waistCm                  Float?
  chestCm                  Float?
  armsCm                   Float?
  thighCm                  Float?
  notes                    String?
  source                   MeasurementSource             @default(LEGACY)
  verificationStatus       MeasurementVerificationStatus @default(LEGACY)
  verifiedByUserId         String?
  verifiedByUser           User?                         @relation("MeasurementVerifications", fields: [verifiedByUserId], references: [id])
  verifiedAt               DateTime?
  verificationNote         String?
  submissionId             String?                       @unique
  submission               AthleteCheckInSubmission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  supersededBySubmissionId String?

  @@map("client_measurement_histories")
}

model AthleteCheckInSchedule {
  id                        String                     @id @default(uuid())
  clientId                  String                     @unique
  client                    ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  configuredByCoachId       String?
  configuredByCoach         CoachProfile?              @relation(fields: [configuredByCoachId], references: [id])
  weightFrequencyDays       Int?
  measurementFrequencyDays  Int?
  otherReadingFrequencyDays Int?
  photoFrequencyDays        Int?
  lastWeightAt              DateTime?
  lastMeasurementAt         DateTime?
  lastOtherReadingAt        DateTime?
  lastPhotoAt               DateTime?
  nextWeightDueAt           DateTime?
  nextMeasurementDueAt      DateTime?
  nextOtherReadingDueAt     DateTime?
  nextPhotoDueAt            DateTime?
  notes                     String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  submissions               AthleteCheckInSubmission[]
  checkInRequests           CheckInRequest[]

  @@map("athlete_check_in_schedules")
}

model AthleteCheckInSubmission {
  id                   String                     @id @default(uuid())
  clientId             String
  client               ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduleId           String?
  schedule             AthleteCheckInSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  checkInRequestId     String?
  checkInRequest       CheckInRequest?            @relation(fields: [checkInRequestId], references: [id], onDelete: SetNull)

  submittedAt          DateTime                   @default(now())

  // Self-reported measurements snapshot
  weightKg             Float?
  heightCm             Float?
  bodyFatPercentage    Float?
  muscleMassKg         Float?
  waistCm              Float?
  chestCm              Float?
  armsCm               Float?
  thighCm              Float?

  currentIssues        String?
  athleteNotes         String?

  correctsSubmissionId String?
  correctsSubmission   AthleteCheckInSubmission?  @relation("CorrectionChain", fields: [correctsSubmissionId], references: [id], onDelete: SetNull)
  corrections          AthleteCheckInSubmission[] @relation("CorrectionChain")

  progressPhotos       ClientProgressPhoto[]
  generatedMeasurement ClientMeasurementHistory?

  reviewStatus         CheckInReviewStatus        @default(PENDING)
  reviewedByUserId     String?
  reviewedByUser       User?                      @relation("SubmissionReviews", fields: [reviewedByUserId], references: [id])
  reviewedAt           DateTime?
  coachReviewNotes     String?

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([clientId, submittedAt])
  @@index([checkInRequestId])
  @@map("athlete_check_in_submissions")
}

model CheckInRequest {
  id                 String                     @id @default(uuid())
  clientId           String
  client             ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedByCoachId String
  requestedByCoach   CoachProfile               @relation("RequestedByCoach", fields: [requestedByCoachId], references: [id])
  scheduleId         String?
  schedule           AthleteCheckInSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  requestedMetrics   String[]                   @default([])
  dueAt              DateTime
  notes              String?

  status             CheckInRequestStatus       @default(PENDING)

  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewedByUser     User?                      @relation("RequestReviews", fields: [reviewedByUserId], references: [id])
  reviewNotes        String?

  cancelledAt        DateTime?
  cancelledReason    String?

  submissions        AthleteCheckInSubmission[]

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([clientId, status])
  @@index([requestedByCoachId])
  @@map("check_in_requests")
}

model ClientGoal {
  id            String        @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  goalType      GoalType
  title         String
  startingValue Float
  targetValue   Float
  currentValue  Float
  unit          String        @default("KG")
  deadline      DateTime?
  status        GoalStatus    @default(IN_PROGRESS)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("client_goals")
}

model ClientMedicalRestriction {
  id                  String              @id @default(uuid())
  clientId            String
  client              ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conditionName       String
  bodyPart            BodyPart
  severity            RestrictionSeverity @default(MEDIUM)
  description         String?
  restrictedMuscles   String[]
  restrictedExercises String[]
  isActive            Boolean             @default(true)
  notes               String?
  createdAt           DateTime            @default(now())

  @@map("client_medical_restrictions")
}

model ClientProgressPhoto {
  id               String                     @id @default(uuid())
  clientId         String
  client           ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date             DateTime                   @default(now())
  frontImageUrl    String?
  sideImageUrl     String?
  backImageUrl     String?
  frontStorageKey  String?
  sideStorageKey   String?
  backStorageKey   String?
  frontMimeType    String?
  sideMimeType     String?
  backMimeType     String?
  uploadedByUserId String?
  weightAtTime     Float?
  notes            String?
  recordType       PhotoRecordType            @default(PHYSIQUE_SET)
  submissionId     String?
  submission       AthleteCheckInSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  assets           ClientProgressPhotoAsset[]

  @@map("client_progress_photos")
}

model ClientProgressPhotoAsset {
  id               String              @id @default(uuid())
  photoId          String
  photo            ClientProgressPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  angle            PhotoAssetAngle     @default(NOT_APPLICABLE)
  storageKey       String
  mimeType         String
  fileSizeBytes    Int
  uploadedByUserId String?
  uploadedByUser   User?               @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@index([photoId])
  @@map("client_progress_photo_assets")
}

model ClientAssessment {
  id               String        @id @default(uuid())
  clientId         String
  client           ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId          String
  coach            CoachProfile  @relation(fields: [coachId], references: [id])
  date             DateTime      @default(now())
  title            String
  pushupsCount     Int?
  pullupsCount     Int?
  plankSeconds     Int?
  runningKmTimeSec Int?
  flexibilityScore Int?
  vo2Max           Float?
  coachNotes       String?

  @@map("client_assessments")
}

enum EventType {
  GROUP_CLASS
  CHAMPIONSHIP
  CAMP
  SEMINAR_WORKSHOP
  GENERAL_EVENT
}

enum EventMode {
  ONLINE
  IN_PERSON
}

enum AudienceScope {
  WHOLE_ACADEMY
  BY_SPORT
  COACH_ROSTER
  SELECTED_ATHLETES
}

model SessionCalendar {
  id              String        @id @default(uuid())
  coachId         String
  coach           CoachProfile  @relation(fields: [coachId], references: [id])
  sportId         String?
  sport           Sport?        @relation(fields: [sportId], references: [id])
  title           String
  sessionType     SessionType   @default(INDIVIDUAL)
  eventType       EventType     @default(GROUP_CLASS)
  eventMode       EventMode     @default(ONLINE)
  onlineLink      String?
  location        String?
  description     String?
  audienceScope   AudienceScope @default(WHOLE_ACADEMY)
  isAllDay        Boolean       @default(false)
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int           @default(1)

  attendances     SessionAttendance[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@map("session_calendars")
}

model SessionAttendance {
  id        String           @id @default(uuid())
  sessionId String
  session   SessionCalendar  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId  String
  client    ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  notes     String?

  @@unique([sessionId, clientId])
  @@map("session_attendances")
}

model MealPlan {
  id            String        @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId       String
  coach         CoachProfile  @relation(fields: [coachId], references: [id])
  title         String
  dailyCalories Int           @default(2000)
  proteinGrams  Int           @default(150)
  carbsGrams    Int           @default(200)
  fatsGrams     Int           @default(60)
  waterLiters   Float         @default(3.0)
  breakfast     String?
  lunch         String?
  dinner        String?
  snacks        String?
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@map("meal_plans")
}

model ClientNutritionAssignment {
  id                  String                  @id @default(uuid())
  clientId            String
  client              ClientProfile           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachId             String?
  coach               CoachProfile?           @relation(fields: [coachId], references: [id])
  nutritionProgramId  String?
  nutritionProgram    NutritionProgram?       @relation(fields: [nutritionProgramId], references: [id], onDelete: SetNull)
  programAssignmentId String?
  programAssignment   ProgramAssignment?      @relation(fields: [programAssignmentId], references: [id], onDelete: SetNull)
  mode                NutritionAssignmentMode @default(INHERITED)
  title               String
  description         String?
  dailyCalories       Int?
  proteinGrams        Int?
  carbsGrams          Int?
  fatsGrams           Int?
  waterLiters         Float?
  breakfast           String?
  lunch               String?
  dinner              String?
  snacks              String?
  notes               String?
  mealsJson           Json?
  startDate           DateTime                @default(now())
  endDate             DateTime?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  dailyLogs           DailyNutritionLog[]

  @@index([clientId, isActive])
  @@map("client_nutrition_assignments")
}

model DailyNutritionLog {
  id                    String                     @id @default(uuid())
  clientId              String
  client                ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nutritionAssignmentId String?
  nutritionAssignment   ClientNutritionAssignment? @relation(fields: [nutritionAssignmentId], references: [id], onDelete: SetNull)
  date                  DateTime
  calories              Float                      @default(0)
  proteinGrams          Float                      @default(0)
  carbsGrams            Float                      @default(0)
  fatsGrams             Float                      @default(0)
  waterLiters           Float                      @default(0)
  isManualEntry         Boolean                    @default(false)
  loggedMealsJson       Json?
  clientNotes           String?
  coachFeedback         String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt

  @@unique([clientId, date])
  @@index([clientId, date])
  @@map("daily_nutrition_logs")
}

model Membership {
  id              String         @id @default(uuid())
  clientId        String
  client          ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planType        MembershipPlan @default(MONTHLY)
  startDate       DateTime
  endDate         DateTime
  totalAmount     Float
  paidAmount      Float          @default(0)
  remainingAmount Float          @default(0)
  paymentStatus   PaymentStatus  @default(PAID)
  paymentMethod   String?        @default("Cash")
  notes           String?
  createdAt       DateTime       @default(now())

  @@map("memberships")
}

model ClientNote {
  id        String        @id @default(uuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  noteType  NoteType      @default(PRIVATE_COACH)
  content   String
  createdAt DateTime      @default(now())

  @@map("client_notes")
}

model Notification {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  message           String
  type              String   @default("INFO")
  read              Boolean  @default(false)
  link              String?
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime @default(now())

  @@index([userId, type, relatedEntityId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Public coach profile visibility flag
model PublicCoachProfile {
  id              String   @id @default(uuid())
  coachProfileId  String   @unique
  coachProfile    CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  isPublic        Boolean  @default(false)
  displayOrder    Int      @default(0)
  publicTitle     String?  // e.g. "Head Boxing Coach"
  publicBio       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("public_coach_profiles")
}

// Public membership packages for the landing page
model PublicPackage {
  id              String   @id @default(uuid())
  nameEn          String
  nameAr          String?
  descriptionEn   String?
  descriptionAr   String?
  price           Float
  currency        String   @default("EGP")
  durationDays    Int
  sessionsCount   Int?     // null = unlimited
  sportsIncluded  String[] // sport names
  benefits        String[] // list of benefit strings
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          PublicOffer[]
  @@map("public_packages")
}

// Championship records
model Championship {
  id          String   @id @default(uuid())
  title       String
  description String?
  year        Int?
  date        DateTime?
  imageUrls   String[]
  videoUrl    String?
  results     String?
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("championships")
}

// Offers / Promotions
model PublicOffer {
  id          String    @id @default(uuid())
  packageId   String?
  package     PublicPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title       String
  description String?
  discount    Float?    // percentage
  promoPrice  Float?    // override price
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("public_offers")
}

// Academy public settings (key-value store)
model AcademySetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  @@map("academy_settings")
}

// Gallery images
model GalleryImage {
  id          String   @id @default(uuid())
  imageUrl    String
  storageKey  String?
  caption     String?
  category    String?  // "training", "events", "academy"
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  @@map("gallery_images")
}

